# ===== CPU 版 Docker 镜像（基于 OpenVINO）=====
FROM openvino/ubuntu22_runtime:2024.0.0

USER root
WORKDIR /app

# 安装 Python 依赖
RUN apt-get update && apt-get install -y python3-pip nodejs npm && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml poetry.lock* ./
RUN pip install poetry && poetry config virtualenvs.create false && poetry install --no-root --without dev

# 复制源码
COPY core/ ./core/
COPY backend/ ./backend/
COPY models/ ./models/
COPY configs/ ./configs/

# 构建前端
COPY frontend/ ./frontend/
RUN cd frontend && npm ci && npm run build

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
