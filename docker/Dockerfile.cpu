# ===== Stage 1: 前端构建（Node 20 环境）=====
FROM node:20-alpine AS frontend-builder
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ===== Stage 2: CPU 运行镜像（基于 OpenVINO）=====
FROM openvino/ubuntu22_runtime:2024.0.0

USER root
WORKDIR /app

# 安装 Python 运行与构建依赖
RUN apt-get update && apt-get install -y python3-pip && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml poetry.lock* ./
RUN pip install poetry && poetry config virtualenvs.create false && poetry install --no-root --without dev

# 复制源码与配置
COPY core/ ./core/
COPY backend/ ./backend/
COPY models/ ./models/
COPY configs/ ./configs/

# 拷贝 Stage 1 构建完成的前端静态资源
COPY --from=frontend-builder /build/frontend/dist ./frontend/dist

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
